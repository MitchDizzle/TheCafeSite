{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "thecafe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 8080
    },
    {
      "name": "kitchen-mock",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "kitchen/server.js"
      ],
      "env": {
        "KITCHEN_MOCK": "1",
        "KITCHEN_DEV": "1"
      },
      "port": 8090
    }
  ]
}