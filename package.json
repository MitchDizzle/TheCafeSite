{
  "name": "thecafe-site",
  "version": "1.0.0",
  "description": "Static site for The Cafe — catering & meal prep, Leavenworth KS",
  "private": true,
  "scripts": {
    "start": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy",
    "export": "npm run build && node scripts/export-studio.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  }
}
