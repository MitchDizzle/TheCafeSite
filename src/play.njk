---
layout: layouts/base.njk
title: "Order Up | The Café"
description: "A little game from The Café in Leavenworth, KS: work the flat-top for a week, one shift a day."
pageCss: "/assets/css/play.css"
bodyClass: "ou-body"
noSiteJs: true
# noindex comes from site.json (game.listed) by way of play.11tydata.js.
ogTitle: "Order Up | A little game from The Café"
ogDescription: "Work the flat-top at The Café in Leavenworth, KS for a week: tickets in, plates out."
ogImage: "/studio/downloads/share-order-up.png"
headExtra: |
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@700;900&display=swap" rel="stylesheet">
      <meta name="theme-color" content="#1F4552">
---
{# Order Up: a phone game. A short-order cook's week at The Café, one shift a
   day, with gear and tricks picked up after close. Three levels (Easy,
   Regular, Rush), food that needs flipping, and slow jazz made in the
   browser if the player turns it on.

   The plan, the rules of the look and the words are in game/README.md; the
   foods, tickets, items, odds and difficulty are data in src/_data/game.json
   (handed over by play.11tydata.js); the logic is assets/js/play.js; the
   drawings are partials/game/sprites.njk.

   Unlisted until site.json says otherwise (game.listed): noindex, no link in
   the footer or on /menu, off the sitemap. Like the home page it has no nav or footer: the game
   is the whole screen.

   This file is only the shell: the title screen and the kitchen's fixed
   parts. play.js fills in everything that changes. Nothing here is a person:
   the staff don't want their likeness online, so the game is seen from the
   cook's own eyes. #}
{% include "partials/game/sprites.njk" %}

<main class="ou" id="ou">
  <div class="ou-stage" id="ou-stage">

    {# ---------- title ---------- #}
    <section class="ou-scr ou-title" data-scr="title">
      {# The café's front at sunrise (partials/game/storefront.njk, drawn from
         the café's photos). Cropped a little at the top; the last strip fades
         into the teal below. #}
      <svg class="ou-title-sky" viewBox="0 14 360 196" preserveAspectRatio="xMidYMax slice" role="img" aria-label="The Café's brick front at sunrise">
        {% include "partials/game/storefront.njk" %}
        <rect x="0" y="198" width="360" height="12" fill="url(#sf-fade)"/>
      </svg>
      <div class="ou-title-gap"></div>
      <div class="ou-title-body">
        <div class="ou-wordmark">{% inlineSvg "/assets/thecafe.svg", "", site.name %}</div>
        <h1>Order Up</h1>
        {# play.js turns this into "Continue: Wednesday" when a week was left
           half way, and shows "New week" beside it. #}
        {# With a week saved: Continue, and New week right beside it (behind
           a "start over?" check, so a week is never lost to a stray tap). #}
        <div class="ou-gorow">
          <button class="ou-btn" data-act="start" id="ou-go">Start the week</button>
          <button class="ou-btn ou-btn--ghost" data-act="fresh" id="ou-fresh" hidden>New week</button>
        </div>
        <div class="ou-confirm" id="ou-confirm" hidden role="alertdialog" aria-labelledby="ou-confirm-q">
          <p id="ou-confirm-q"></p>
          <div class="ou-row">
            <button class="ou-btn" data-act="start">Start over</button>
            <button class="ou-btn ou-btn--ghost" data-act="keep">Keep it</button>
          </div>
        </div>
        <div class="ou-levels" id="ou-levels" role="group" aria-label="How hard"></div>
        <p class="ou-level-text" id="ou-level-text"></p>
        {# Shown once, the first time, and only when results go somewhere
           (site.json game.statsUrl). play.js decides. #}
        <div class="ou-told" id="ou-told" hidden role="dialog" aria-labelledby="ou-told-h">
          <p id="ou-told-h"><b>Before you play</b></p>
          <p>Your progress is saved on this phone. The game also tells The Café how your weeks go, with no name, so we can see whether it's too hard. No cookies, no ads.</p>
          <div class="ou-row">
            <button class="ou-btn" data-told="ok">OK</button>
            <button class="ou-btn ou-btn--ghost" data-told="no">Don't send</button>
          </div>
          <a class="ou-link" href="/privacy">Privacy</a>
        </div>
        <div class="ou-title-links">
          <button class="ou-link" data-act="how">How to play</button>
          <button class="ou-link" data-act="box">Recipe Box</button>
          <button class="ou-link" data-act="sound" id="ou-sound-title">Sound: off</button>
          <button class="ou-link" data-act="music" id="ou-music-title">Music: off</button>
        </div>
      </div>
      <div class="ou-title-foot">
        <span id="ou-best"></span><br>
        <a class="ou-link" href="/menu">See the real menu</a>
        <span class="ou-version">v{{ site.game.version }}</span>
      </div>
    </section>

    {# ---------- the kitchen ---------- #}
    <section class="ou-scr ou-shift" data-scr="shift" hidden>
      <header class="ou-hud">
        <button class="ou-pause" data-act="pause" aria-label="Pause"></button>
        <div class="ou-when"><span class="ou-label" id="ou-day">Monday</span><b id="ou-clock">6:00am</b></div>
        <div class="ou-cups" id="ou-cups" role="img" aria-label="Coffees left"></div>
        <div class="ou-tips"><span class="ou-label">Tips</span><b id="ou-tips">$0</b></div>
      </header>
      <div class="ou-rail" id="ou-rail" aria-label="Tickets"></div>
      <div class="ou-pass" id="ou-pass">
        <span class="ou-sun" aria-hidden="true"></span>
        <span class="ou-pass-phase ou-label" id="ou-phase">Breakfast</span>
        <div class="ou-crew" id="ou-crew"></div>
      </div>
      <div class="ou-griddle" id="ou-griddle" aria-label="The flat-top"></div>
      <div class="ou-table">
        <div class="ou-side">
          <div class="ou-hint" id="ou-hint" aria-live="polite"></div>
          <button class="ou-scrap" id="ou-scrap" data-act="scrap">Scrap</button>
        </div>
        <div class="ou-plate" id="ou-plate" aria-label="The plate"></div>
        <div class="ou-sendwrap"><button class="ou-send is-off" id="ou-send" data-act="send">Send</button></div>
      </div>
      <div class="ou-bins" id="ou-bins" aria-label="The bins"></div>

      <div class="ou-bubbles" id="ou-bubbles"></div>
      <div class="ou-toast" id="ou-toast" role="status"></div>
      <div class="ou-banner" id="ou-banner"></div>
      <div class="ou-pausebox" id="ou-pausebox" hidden>
        <div class="ou-pausecard">
          <h2 class="ou-h">Paused</h2>
          <button class="ou-btn" data-act="resume">Back to the line</button>
          <div class="ou-row">
            <button class="ou-btn ou-btn--quiet" data-act="sound" id="ou-sound-pause">Sound: off</button>
            <button class="ou-btn ou-btn--quiet" data-act="music" id="ou-music-pause">Music: off</button>
          </div>
          <button class="ou-btn ou-btn--quiet" data-act="leave">Back to the title</button>
          <p class="ou-note ou-pausenote">Your week is kept from this morning.</p>
          <button class="ou-btn ou-btn--quiet" data-act="quit">End the week</button>
        </div>
      </div>
    </section>

    {# ---------- filled in by play.js ---------- #}
    <section class="ou-scr ou-paper" data-scr="dawn" hidden></section>
    <section class="ou-scr ou-paper" data-scr="close" hidden></section>
    <section class="ou-scr ou-paper" data-scr="over" hidden></section>
    <section class="ou-scr ou-paper" data-scr="box" hidden></section>
    <section class="ou-scr ou-paper" data-scr="how" hidden></section>

  </div>
  {# If the game's script doesn't load or falls over, say so and offer the
     menu, instead of leaving a title screen whose buttons do nothing. #}
  <div class="ou-oops" id="ou-oops" hidden>
    <p><b>The game didn't start.</b> It may be the connection. The menu still works.</p>
    <a class="ou-btn" href="/play">Try again</a>
    <a class="ou-btn ou-btn--quiet" href="/menu">See the menu</a>
  </div>
  <noscript><p style="color:#FAF7F2;padding:24px;font:400 17px Lato,sans-serif">Order Up needs JavaScript. The menu doesn't: <a href="/menu" style="color:#8ED9D4">see the menu</a>.</p></noscript>
</main>

<script id="ou-data" type="application/json">{{ gameJson | safe }}</script>
<script>
  // The game sets window.ouStarted when it is up. If its script errors, or
  // never arrives, show the note above.
  (function () {
    var oops = function () { if (!window.ouStarted) document.getElementById('ou-oops').hidden = false; };
    window.addEventListener('error', function (e) { if (/play\.js/.test((e && e.filename) || '') || (e && e.target && e.target.tagName === 'SCRIPT')) oops(); }, true);
    window.addEventListener('load', function () { setTimeout(oops, 1500); });
  })();
</script>
<script src="{{ '/assets/js/play.js' | bust }}"></script>
