# ============================================================
# The Cafe — lvcafetogo.com
# ============================================================

AddDefaultCharset UTF-8

# No directory listings
Options -Indexes

# ── Canonical URLs: force https + apex domain ──────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www.lvcafetogo.com → lvcafetogo.com
    RewriteCond %{HTTP_HOST} ^www\.lvcafetogo\.com$ [NC]
    RewriteRule ^ https://lvcafetogo.com%{REQUEST_URI} [R=301,L]

    # http → https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://lvcafetogo.com%{REQUEST_URI} [R=301,L]

    # /index.html → / (matches canonical + og:url)
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # /page.html → /page (drop the extension from visible URLs)
    RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # serve /page from page.html internally
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── Custom error page ───────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript image/svg+xml application/xml application/json
</IfModule>

# ── Browser caching ─────────────────────────────────────────
# HTML stays fresh (site still changing); assets cache longer.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# ── Private studio board ────────────────────────────────────
# /studio/ is the internal proof board: flyers, menus, print pieces and
# social art shown to the client before they go out.
#
# It is deliberately absent from robots.txt and sitemap.xml. A Disallow line
# would name the path in a world-readable file, which tells the scrapers that
# ignore robots.txt exactly where to look. The header below is what actually
# keeps the board out of search results, and unlike a <meta> tag it also
# covers the PDFs and PNGs served from studio/files/ — a binary has nowhere
# to put a meta tag, and the images are the part worth scraping.
#
# This is obscurity plus a no-index request, NOT access control. Anyone with
# the URL can read it. For real protection, uncomment the Basic Auth block
# below and create the password file outside the web root:
#     htpasswd -c /home/USER/.studio-htpasswd cafe
# The .htpasswd file must never be committed — this is a public repo.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/studio(/|$)" STUDIO_AREA
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" env=STUDIO_AREA
</IfModule>

# <IfModule mod_authn_file.c>
#     <If "%{REQUEST_URI} =~ m#^/studio(/|$)#">
#         AuthType Basic
#         AuthName "The Cafe Studio"
#         AuthUserFile /home/USER/.studio-htpasswd
#         Require valid-user
#     </If>
# </IfModule>

# ── Security headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS only once the request is already https (180 days)
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>
