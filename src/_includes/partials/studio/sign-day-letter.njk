{#- One day's lunch special and soup of the day on letter paper, a page
    each (client 2026-11-09: the 11 × 17 poster printer isn't available, so
    the board signs go through the office colour printer for now, which
    must not burn ink). The day is `signDate` in the piece's front matter.

    Same words as the board signs (sign-day-specials.njk): "Today's
    Special", no day or date, so a sheet goes up again when the plate comes
    back; the Deli Salads to pick or swap in. Ink-light: white ground,
    coloured TYPE and thin rules only, no filled panel or box anywhere.
    Sized down from the 11 × 17 sheet by about the width ratio. -#}
{%- set d = (specials.days | where("date", signDate))[0] %}
{%- set soupCat = (menu.categories | where("id", "soup"))[0] %}
{%- set sidesCat = (menu.categories | where("id", "sides"))[0] %}
{%- set deli = (sidesCat.items | selectattr("choices") | first) if sidesCat else null %}
<div class="ds-stack">
{%- if d and onePage %}
    {#- One page for the front counter (client 2026-11-09: two holders
        there, one for the sides sign he points at while taking orders, so
        everything else goes on this one): the plate, the soup and the
        desserts, no swap list (the sides sign has it). -#}
    {%- set sides = d | specialSides(true) %}
    {%- set fridge = (collections.studio | where("fileSlug", "sign-desserts-bw"))[0] %}
    {%- set drows = [] %}
    {%- if fridge %}
    {%- from "partials/studio/dessert-rows.njk" import collect %}
    {{- collect(desserts, fridge.data, drows) }}
    {%- endif %}
    <div class="canvas sign dl dl--one">
        <header class="dl-top">
            <p class="p-display dl-head ink-accent">Today&rsquo;s Special</p>
            <p class="dl-when ink-teal">Lunch special &amp; soup from 11am</p>
        </header>

        <section class="dl1-block">
            <p class="p-display dl1-name{% if d.special.length > 24 %} dl1-name--long{% endif %} ink-teal">{{ d.special }}</p>
            {%- if sides %}
            <p class="dl1-detail">{{ sides }}</p>
            {%- endif %}
            {%- if specials.includesDrink %}
            <p class="dl-drink dl1-drink ink-accent">Includes a drink</p>
            {%- endif %}
        </section>

        {%- if d.soup %}
        <section class="dl1-block dl1-block--rule">
            <p class="p-label dl-label dl1-label ink-accent">Soup of the Day</p>
            <p class="p-display dl1-name dl1-name--soup{% if d.soup.length > 20 %} dl1-name--long{% endif %} ink-teal">{{ d.soup }}</p>
            {%- if soupCat and soupCat.items %}
            <p class="dl1-detail">{% for s in soupCat.items %}{% if not loop.first %} &middot; {% endif %}{{ s.name }} {{ s.price | money }}{% endfor %}</p>
            {%- endif %}
            {%- if d.soupNote %}
            <p class="dl-note dl1-note">{{ d.soupNote }}</p>
            {%- endif %}
        </section>
        {%- endif %}

        {%- if drows.length %}
        <section class="dl1-block dl1-block--rule dl1-desserts">
            <p class="p-label dl-label dl1-label ink-accent">Desserts</p>
            <ul class="dl1-rows{% if drows.length > 6 %} dl1-rows--most{% elif drows.length > 3 %} dl1-rows--more{% endif %}">
                {%- for r in drows %}
                <li class="sign-row">
                    <div class="sign-row-head">
                        <span class="sign-row-name ink-teal">{{ r.name }}</span>
                        <span class="sign-row-fill" aria-hidden="true"></span>
                        <span class="sign-row-price ink-accent">{{ r.price | money }}</span>
                    </div>
                </li>
                {%- endfor %}
            </ul>
        </section>
        {%- endif %}
    </div>
{%- elif d %}
    {%- set sides = d | specialSides(true) %}
    <div class="canvas sign dl">
        <header class="dl-top">
            <p class="p-display dl-head ink-accent">Today&rsquo;s Special</p>
            <p class="dl-when ink-teal">Lunch special from 11am</p>
        </header>

        <div class="dl-main">
            <p class="p-display dl-special{% if d.special.length > 32 %} dl-special--longer{% elif d.special.length > 20 %} dl-special--long{% endif %} ink-teal">{{ d.special }}</p>
            {%- if sides %}
            <p class="dl-sides">{{ sides }}</p>
            {%- endif %}
            {%- if specials.includesDrink %}
            <p class="dl-drink ink-accent">Includes a drink</p>
            {%- endif %}
        </div>

        {%- if deli and sides %}
        <section class="dl-swap">
            <p class="p-label dl-label ink-accent">{% if d.anySide %}Pick your side{% else %}Swap a side for any of these{% endif %}</p>
            <ul class="dl-swap-list">
                {%- for c in deli.choices %}
                <li>{{ c }}</li>
                {%- endfor %}
                {%- if specials.soupSide %}
                <li>Cup of the soup of the day</li>
                {%- endif %}
            </ul>
        </section>
        {%- endif %}
    </div>

    {%- if d.soup %}
    <div class="canvas sign dl dl--soup">
        <header class="dl-top">
            <p class="p-display dl-head ink-accent">Soup of the Day</p>
            <p class="dl-when ink-teal">From 11am</p>
        </header>
        <div class="dl-main">
            <p class="p-display dl-soup{% if d.soup.length > 16 %} dl-soup--long{% endif %} ink-teal">{{ d.soup }}</p>
            {%- if soupCat and soupCat.items %}
            <p class="dl-sides">{% for s in soupCat.items %}{% if not loop.first %} &middot; {% endif %}{{ s.name }} {{ s.price | money }}{% endfor %}</p>
            {%- endif %}
            {%- if d.soupNote %}
            <p class="dl-note">{{ d.soupNote }}</p>
            {%- endif %}
        </div>
    </div>
    {%- endif %}

    {#- The desserts, for the counter: the dessert fridge sign's rows, from
        its own front matter (found in collections.studio), so the two
        always agree. Left off if that sign isn't built (archived). #}
    {%- set fridge = (collections.studio | where("fileSlug", "sign-desserts-bw"))[0] if dessertPage else null %}
    {%- if fridge %}
    {%- from "partials/studio/dessert-rows.njk" import collect %}
    {%- set drows = [] %}
    {{- collect(desserts, fridge.data, drows) }}
    <div class="canvas sign dl dl--desserts">
        <header class="dl-top">
            <p class="p-display dl-head ink-accent">Desserts</p>
            <p class="dl-when ink-teal">Ask at the counter</p>
        </header>
        <ul class="dl-rows">
            {%- for r in drows %}
            <li class="sign-row{% if r.name.length > 18 %} dl-row--long{% endif %}">
                <div class="sign-row-head">
                    <span class="sign-row-name ink-teal">{{ r.name }}</span>
                    <span class="sign-row-fill" aria-hidden="true"></span>
                    <span class="sign-row-price ink-accent">{{ r.price | money }}</span>
                </div>
            </li>
            {%- else %}
            <li class="dl-sides">Ask at the counter what's in today.</li>
            {%- endfor %}
        </ul>
    </div>
    {%- endif %}
{%- else %}
    <div class="canvas sign dl"><p class="dl-sides">No special in specials.json for {{ signDate }}.</p></div>
{%- endif %}
</div>
