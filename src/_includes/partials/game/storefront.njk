{#- The flag as it hangs in the window: 13 stripes and 50 stars (rows of six and five), too small to see one by one but all there (owner 2026-11-13: the drawing had 8 stars; a real flag, drawn small, is the respectful way). -#}
<g fill="#A65342">{% for i in range(0, 13, 2) %}<rect x="279.500" y="{{ (129.5 + i * 31 / 13) | round(2) }}" width="39" height="{{ (31 / 13) | round(3) }}"/>{% endfor %}</g>
<rect x="279.500" y="129.500" width="17" height="{{ (7 * 31 / 13) | round(2) }}" fill="#2B4664"/>
<g fill="#EDE6D8">{% for r in range(1, 10) %}{% for k in range(1, 12) %}{% if (r + k) % 2 == 0 %}<circle cx="{{ (279.5 + 17 * k / 12) | round(2) }}" cy="{{ (129.5 + (7 * 31 / 13) * r / 10) | round(2) }}" r=".45"/>{% endif %}{% endfor %}{% endfor %}</g>
