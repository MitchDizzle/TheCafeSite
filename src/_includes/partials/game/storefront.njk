{#- The Café's front at sunrise, for Order Up's title screen and the pieces
    that advertise it (studio/share-order-up, studio/fb-order-up).

    Drawn from the café's own photos (assets/photos/storefront.jpg and the
    two dawn photos in assets/gallery/): the low brick front with its cap, the
    two pairs of windows (the saying and the sunrise on the left; the sign
    with the name, address and number, and the flag, on the right), the glass
    door with a notice taped in it, the light beside it, the 417 plaque, the
    black railing along the walk, the wheel stops and yellow lines of the lot,
    the trees and the roof unit behind, and the lot still wet and pink from
    the sky. No people, as everywhere in the game.

    Flat shapes only, like the rest of the game (game/README.md). The name in
    the window is the real wordmark's outline (the svgPath filter), never
    retyped in a font. Every id starts "sf-" so this can sit in a page beside
    the sprite sheet. The viewBox is cropped by whoever includes it:
    0 0 360 210 is the whole drawing, sky to lot. -#}
<defs>
  <linearGradient id="sf-sky" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#8F7FBE"/><stop offset=".34" stop-color="#C79AC4"/>
    <stop offset=".62" stop-color="#F4A9B8"/><stop offset=".86" stop-color="#F8BE8A"/><stop offset="1" stop-color="#FAD9A0"/>
  </linearGradient>
  <linearGradient id="sf-photo" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#F29E4C"/><stop offset=".7" stop-color="#F9D27A"/><stop offset="1" stop-color="#FCE7A8"/>
  </linearGradient>
  <linearGradient id="sf-glass" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#31474F"/><stop offset=".55" stop-color="#4A5E5E"/><stop offset="1" stop-color="#C9A560"/>
  </linearGradient>
  <linearGradient id="sf-wet" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#F4A9B8" stop-opacity=".34"/><stop offset=".6" stop-color="#C79AC4" stop-opacity=".12"/><stop offset="1" stop-color="#C79AC4" stop-opacity="0"/>
  </linearGradient>
  <linearGradient id="sf-fade" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#1F4552" stop-opacity="0"/><stop offset="1" stop-color="#1F4552"/>
  </linearGradient>
  {#- The brick: mottled, as the real wall is. Mortar is the ground; each
      brick is laid on it, and every other course is shifted half a brick. -#}
  <pattern id="sf-brick" width="36" height="18" patternUnits="userSpaceOnUse">
    <rect width="36" height="18" fill="#62402F"/>
    <g>
      <rect x=".3" y=".3" width="8.4" height="3.9" fill="#8C5B4A"/><rect x="9.3" y=".3" width="8.4" height="3.9" fill="#9E6B55"/><rect x="18.3" y=".3" width="8.4" height="3.9" fill="#7E5142"/><rect x="27.3" y=".3" width="8.4" height="3.9" fill="#8C5B4A"/>
      <rect x="-4.2" y="4.8" width="8.4" height="3.9" fill="#A9785F"/><rect x="4.8" y="4.8" width="8.4" height="3.9" fill="#855646"/><rect x="13.8" y="4.8" width="8.4" height="3.9" fill="#8C5B4A"/><rect x="22.8" y="4.8" width="8.4" height="3.9" fill="#74493B"/><rect x="31.8" y="4.8" width="8.4" height="3.9" fill="#A9785F"/>
      <rect x=".3" y="9.3" width="8.4" height="3.9" fill="#7E5142"/><rect x="9.3" y="9.3" width="8.4" height="3.9" fill="#8C5B4A"/><rect x="18.3" y="9.3" width="8.4" height="3.9" fill="#A27059"/><rect x="27.3" y="9.3" width="8.4" height="3.9" fill="#855646"/>
      <rect x="-4.2" y="13.8" width="8.4" height="3.9" fill="#8C5B4A"/><rect x="4.8" y="13.8" width="8.4" height="3.9" fill="#9E6B55"/><rect x="13.8" y="13.8" width="8.4" height="3.9" fill="#74493B"/><rect x="22.8" y="13.8" width="8.4" height="3.9" fill="#8C5B4A"/><rect x="31.8" y="13.8" width="8.4" height="3.9" fill="#9E6B55"/>
    </g>
  </pattern>
  <pattern id="sf-rails" width="5" height="16" patternUnits="userSpaceOnUse">
    <rect x="2.1" width=".9" height="16" fill="#161C20"/>
  </pattern>
</defs>

