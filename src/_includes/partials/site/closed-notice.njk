{#- The line at the top of every page for the two weeks before a day the cafe
    is closed (site.closedDays). Pages are uploaded once, so each day ships
    hidden and the script picks on Central time, like the specials box: an old
    closure is hidden, never shown. -#}
{#- Also a day marked closed in specials.json (on the kitchen board, Mitch
    2026-11-18) that site.closedDays doesn't already have. -#}
{%- set siteClosed = site.closedDays or [] %}
{%- set boardClosed = [] %}
{%- set siteDates = [] %}{% for c in siteClosed %}{% set _ = siteDates.push(c.date) %}{% endfor %}
{%- for d in (specials.days or []) %}{% if d.closed and not (d.date in siteDates) %}{% set _ = boardClosed.push(d) %}{% endif %}{% endfor %}
{%- if siteClosed.length or boardClosed.length %}
{%- for c in siteClosed %}
    <div class="construction-banner" role="note" data-closed-day="{{ c.date }}" hidden>
        Closed for {{ c.name }}, <span style="white-space:nowrap">{{ c.date | dayDate("long") }}</span>
    </div>
{%- endfor %}
{%- for d in boardClosed %}
    <div class="construction-banner" role="note" data-closed-day="{{ d.date }}" hidden>
        {{ d | closedText }}, <span style="white-space:nowrap">{{ d.date | dayDate("long") }}</span>
    </div>
{%- endfor %}
    <script>
        (function () {
            var central = function (ms) {
                return new Date(ms).toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });
            };
            var today = central(Date.now());
            var soon = central(Date.now() + 14 * 864e5);
            document.querySelectorAll('[data-closed-day]').forEach(function (el) {
                var day = el.getAttribute('data-closed-day');
                el.hidden = day < today || day > soon;
            });
        })();
    </script>
{%- endif %}
