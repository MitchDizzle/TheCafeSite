<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or site.description }}">
    <title>{{ title }}</title>

    {# Canonical and og:url are built from filePathStem, not page.url, because
       permalink writes flat .html files while the site is served and indexed
       at the extensionless form. filePathStem is the only value that matches
       the public URL. #}
    {%- if noindex %}
    {# 404 is served at whatever path was requested, so it has no canonical
       URL of its own — pointing one at /404 would invite indexing the very
       page we are telling crawlers to skip. #}
    <meta name="robots" content="noindex">
    {%- else %}
    {% set canonical = site.url + ("/" if page.filePathStem == "/index" else page.filePathStem) %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ ogDescription or description or site.description }}">
    <meta property="og:url" content="{{ canonical }}">
    <link rel="canonical" href="{{ canonical }}">
    {%- endif %}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | bust }}">
    {% if pageCss %}<link rel="stylesheet" href="{{ pageCss | bust }}">{% endif %}
    {{ headExtra | safe }}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
{{ content | safe }}
{%- if not noSiteJs %}
    <script src="{{ '/assets/js/main.js' | bust }}"></script>
{%- endif %}
</body>
</html>
