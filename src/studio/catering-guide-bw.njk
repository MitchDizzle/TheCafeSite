{#- ===========================================================
    Catering guide — letter portrait, 4 pages, black ink

    The buffet and event catering Dalton runs for the cafe, from
    _data/catering.json. The everyday pickup catering (lunch for 10 off the
    menu) is not in here: that's /catering's form and the menu itself.

    Same construction as the counter menu: fixed pages, two hand-assigned
    columns each, nothing flows between them. A column that overruns is
    CLIPPED, so after adding packages re-proof the PNG and move a whole
    section if one no longer fits.
    =========================================================== #}

{%- set g = catering | cateringGuide %}

{%- macro pkg(p) %}
<div class="cg-pkg">
    <p class="cg-pkg-head">
        <span class="cg-num" aria-label="Number {{ p.n }}">{{ p.n }}</span>
        <span class="cg-name">{{ p.name }}</span>
        <span class="cg-price">{% if p.priceLabel %}{{ p.priceLabel }}{% else %}{{ p.price | money }}{% endif %}</span>
    </p>
    {%- if p.with or p.sides %}
    <p class="cg-with">
        {%- if p.with %}{{ p.with | join(" · ") }}{% endif %}
        {%- if p.with and p.sides %} · {% endif %}
        {%- if p.sides %}<strong>{{ p.sides }} sides</strong> &amp; dessert{% endif -%}
    </p>
    {%- endif %}
</div>
{%- endmacro %}

{%- macro section(s) %}
<section class="cg-section">
    <h2 class="p-display cg-section-name">{{ s.name }}</h2>
    {%- if s.note %}<p class="cg-section-note">{{ s.note }}</p>{% endif %}
    {%- for p in s.packages %}{{ pkg(p) }}{% endfor %}
</section>
{%- endmacro %}

{%- macro sides(list, cols) %}
<section class="cg-section cg-sides">
    <h2 class="p-display cg-section-name">{{ list.name }}</h2>
    <ul class="cg-sides-list{% if cols == 2 %} cg-sides-list--2{% endif %}">
        {%- for item in list.items %}<li>{{ item }}</li>{% endfor %}
    </ul>
</section>
{%- endmacro %}

{%- macro runhead(page) %}
<header class="cg-run">
    <p class="p-display-italic cg-run-name">The Café Catering <span class="cg-amp">&amp;</span> {{ catering.brand }}</p>
    <p class="cg-run-meta"><strong>{{ site.phone }}</strong> &middot; page {{ page }} of 4</p>
</header>
{%- endmacro %}

{%- macro contact() %}
<div class="cg-contact">
    <div class="cg-contact-text">
        <p class="p-display cg-contact-head">Let&rsquo;s plan your event</p>
        <p class="cg-contact-phone">{{ site.phone }}</p>
        <p class="cg-contact-line">{{ catering.email }}</p>
        <p class="cg-contact-line">{{ site.social.website }}/catering</p>
        <p class="cg-contact-line">{{ site.address.street }}, {{ site.address.locality }}, {{ site.address.region }}</p>
    </div>
    <div class="qr cg-qr" aria-hidden="true">{% inlineSvg "/assets/qr-website.svg", "", "" %}</div>
</div>
{%- endmacro %}

<div class="cg-stack">

    <p class="fold-legend">Page 1 &mdash; front of sheet 1</p>
    <div class="canvas cg-page">
        <header class="cg-mast">
            <div class="wordmark wordmark--light cg-wordmark">
                {% inlineSvg "/assets/thecafe.svg", "", site.name %}
            </div>
            <div class="cg-mast-text">
                <p class="p-display cg-mast-title">Catering</p>
                <p class="p-display-italic cg-mast-sub">The Café Catering <span class="cg-amp">&amp;</span> {{ catering.brand }}</p>
                <p class="cg-mast-line">Breakfasts, lunches, buffets and parties, from the kitchen that has cooked for Leavenworth since 2005.</p>
            </div>
        </header>

        <div class="cg-cols">
            <div class="cg-col">
                <section class="cg-how">
                    <h2 class="p-display cg-section-name">How it works</h2>
                    <ul>
                        {%- for line in catering.howItWorks %}<li>{{ line }}</li>{% endfor %}
                    </ul>
                </section>
                {{ section(g.byId.breakfast) }}
            </div>
            <div class="cg-col">
                {{ section(g.byId.lunches) }}
                <div class="cg-spacer"></div>
                <p class="cg-call">To order, call <strong>{{ site.phone }}</strong> with the number of the package and how many guests.</p>
            </div>
        </div>
    </div>

    <p class="fold-legend">Page 2 &mdash; back of sheet 1</p>
    <div class="canvas cg-page">
        {{ runhead(2) }}
        <div class="cg-cols">
            <div class="cg-col">{{ section(g.byId.dropoff) }}</div>
            <div class="cg-col">{{ section(g.byId.cocktail) }}</div>
        </div>
    </div>

    <p class="fold-legend">Page 3 &mdash; front of sheet 2</p>
    <div class="canvas cg-page">
        {{ runhead(3) }}
        <div class="cg-cols">
            <div class="cg-col">{{ section(g.byId.buffets) }}</div>
            <div class="cg-col">{{ sides(catering.sides.buffet, 2) }}</div>
        </div>
    </div>

    <p class="fold-legend">Page 4 &mdash; back of sheet 2</p>
    <div class="canvas cg-page">
        {{ runhead(4) }}
        <div class="cg-cols">
            <div class="cg-col">{{ section(g.byId.bbq) }}</div>
            <div class="cg-col">
                {{ sides(catering.sides.bbq, 2) }}
                <div class="cg-spacer"></div>
                {{ contact() }}
            </div>
        </div>
    </div>

</div>
