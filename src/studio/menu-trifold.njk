{#- Category lookup by id rather than a hand-built dict — Nunjucks has no
    convenient way to assign into an object inside a template, but the
    `where` filter already exists for the studio board's own grouping. -#}
{%- set breakfast = (menu.categories | where("id", "breakfast"))[0] %}
{%- set breakfastSides = (menu.categories | where("id", "breakfast_sides"))[0] %}
{%- set wraps = (menu.categories | where("id", "wraps"))[0] %}
{%- set sandwiches = (menu.categories | where("id", "sandwiches"))[0] %}
{%- set burgers = (menu.categories | where("id", "burgers"))[0] %}
{%- set salads = (menu.categories | where("id", "salads"))[0] %}
{%- set soup = (menu.categories | where("id", "soup"))[0] %}
{%- set sides = (menu.categories | where("id", "sides"))[0] %}
{%- set drinks = (menu.categories | where("id", "drinks"))[0] %}

{%- macro category(c) %}
<div class="menu-cat">
    <h3 class="menu-cat-name p-display ink-teal">{{ c.name }}</h3>
    {%- if c.note %}
    <p class="menu-cat-note p-body">{{ c.note }}</p>
    {%- endif %}
    {%- if c.sizing %}
    <p class="menu-cat-sizing p-label ink-accent">
        {%- for s in c.sizing %}{{ s.size }} {{ s.price | money }}{% if not loop.last %} &middot; {% endif %}{% endfor -%}
    </p>
    {%- endif %}
    <ul class="menu-items">
        {%- for item in c.items %}
        <li class="menu-item">
            <div class="menu-item-head">
                <span class="menu-item-name p-body">{{ item.name }}</span>
                <span class="menu-item-fill" aria-hidden="true"></span>
                {%- if item.price %}
                <span class="menu-item-price p-body">{{ item.price | money }}</span>
                {%- elif item.variants %}
                <span class="menu-item-price p-body">
                    {%- for v in item.variants %}{{ v.size }} {{ v.price | money }}{% if not loop.last %} / {% endif %}{% endfor -%}
                </span>
                {%- endif %}
            </div>
            {%- if item.description %}
            <p class="menu-item-desc p-body">{{ item.description }}</p>
            {%- endif %}
        </li>
        {%- endfor %}
    </ul>
</div>
{%- endmacro %}

{# Screen-only. There is no bleed room to print panel labels on the sheet
   itself, and mislabelling a panel costs a whole print run — so the roles are
   called out here, where they are visible while proofing in the browser and
   gone from the export and the print. #}
<div class="trifold-stack">

    <p class="fold-legend">Sheet 1 &mdash; outside &middot; <strong>tuck flap</strong> (first thing seen on opening) &middot; <strong>back cover</strong> &middot; <strong>front cover / flyer</strong></p>

    {#- OUTSIDE SHEET, as it lies flat, printed side up.

        Panel order here is dictated by the fold, not by reading order. Letter
        fold, right third in first, left third over it: the right panel ends
        up on top of the closed piece (front cover), the middle panel ends up
        on the bottom (back cover), and the LEFT panel is the one that tucks
        away inside — it is the half-spread a customer sees the instant they
        lift the cover, paired with the inside sheet's leftmost panel.

        That is why the tuck flap is first and the back panel second. They
        were the other way round before, which put "Visit us" inside the fold
        and the salads on the back of the piece. -#}
    <div class="canvas trifold-canvas">
        <div class="fold-line" style="left: 33.333%"></div>
        <div class="fold-line" style="left: 66.667%"></div>

        <section class="panel panel-flap">
            <p class="p-eyebrow panel-eyebrow ink-accent">Also on the menu</p>
            {{ category(salads) }}
            {{ category(drinks) }}
        </section>

        <section class="panel panel-back">
            <p class="p-label panel-eyebrow ink-accent">Visit us</p>
            <p class="p-display panel-hours-days ink-teal">{{ site.opening.hoursDays }}</p>
            <p class="p-display panel-hours-time ink-teal">{{ site.opening.opens.time }} <span class="ampm">{{ site.opening.opens.meridiem }}</span> &ndash; {{ site.opening.closes.time }} <span class="ampm">{{ site.opening.closes.meridiem }}</span></p>

            <div class="panel-contact">
                <p class="p-display panel-phone ink-teal">{{ site.phone }}</p>
                <p class="p-body">{{ site.address.street }}</p>
                <p class="p-body">{{ site.address.locality }}, {{ site.address.region }} {{ site.address.postalCode }}</p>
                <p class="p-body">{{ site.email }}</p>
            </div>

            <div class="panel-spacer"></div>

            {# Both codes, side by side, on the panel that ends up face-up on
               a table. assets/qr-*.svg carry no quiet zone of their own —
               .qr's padding IS the quiet zone, so do not trim it. #}
            <div class="panel-codes">
                <div class="code">
                    <div class="qr code-qr">{% inlineSvg "/assets/qr-facebook.svg" %}</div>
                    <p class="p-label code-label ink-accent">Follow</p>
                    <p class="p-body code-line ink-teal">{{ site.social.facebookHandle }}</p>
                </div>
                <div class="code">
                    <div class="qr code-qr">{% inlineSvg "/assets/qr-website.svg" %}</div>
                    <p class="p-label code-label ink-accent">Order &amp; catering</p>
                    <p class="p-body code-line ink-teal">{{ site.social.website }}</p>
                </div>
            </div>
        </section>

        {#- FRONT COVER. Doubles as a flyer, so it has to stand on its own:
            hours, street address, phone and both links live here as well as
            on the back panel.

            NOT a flood of teal. A full-panel fill is a third of the sheet in
            solid ink on both a desktop printer and a copier — it cockles the
            paper and bleeds at the fold. Same answer as the front door
            banner's inset variant: one contained masthead box, everything
            else ruled or set in type on the bare sheet. -#}
        <section class="panel panel-cover">
            <div class="cover-mast">
                <div class="wordmark wordmark--light cover-wordmark">
                    {% inlineSvg "/assets/thecafe.svg", "", site.name %}
                </div>
                <p class="p-display-italic cover-menu ink-cream">Menu</p>
            </div>

            <div class="cover-filigree ink-teal">
                {% include "partials/filigree.njk" %}
            </div>

            <p class="p-body cover-since ink-teal">Serving Leavenworth since {{ site.founded.slice(0, 4) }}</p>

            <div class="panel-spacer"></div>

            <div class="cover-hours">
                <p class="p-label hours-label ink-accent">{{ site.opening.hoursLabel }}</p>
                <p class="p-display hours-days ink-teal">{{ site.opening.hoursDays }}</p>
                <p class="p-display hours-time ink-teal">{{ site.opening.opens.time }} <span class="ampm">{{ site.opening.opens.meridiem }}</span> &ndash; {{ site.opening.closes.time }} <span class="ampm">{{ site.opening.closes.meridiem }}</span></p>
            </div>

            <div class="cover-where">
                <p class="p-display cover-street ink-teal">{{ site.address.street }}</p>
                <p class="p-body cover-city">{{ site.address.locality }}, {{ site.address.region }} {{ site.address.postalCode }}</p>
                <p class="p-display cover-phone ink-teal">{{ site.phone }}</p>
            </div>

            <div class="cover-links">
                <p class="p-body cover-link ink-teal">{{ site.social.website }}</p>
                <p class="p-body cover-link ink-teal">{{ site.social.facebookHandle }}</p>
            </div>
        </section>
    </div>

    <p class="fold-legend">Sheet 2 &mdash; inside &middot; <strong>Breakfast</strong> &middot; lunch &middot; griddle</p>

    {#- INSIDE SHEET — the full menu, read left to right once the piece is
        open flat. Its LEFT panel is the one that pairs with the outside
        sheet's tuck flap in the first half-spread, so breakfast leads: it is
        what a customer reads the moment the cover lifts, before the piece is
        even open all the way. Do not reorder these without re-reading the
        fold note on the outside sheet above. -#}
    <div class="canvas trifold-canvas">
        <div class="fold-line" style="left: 33.333%"></div>
        <div class="fold-line" style="left: 66.667%"></div>

        <section class="panel">
            {{ category(breakfast) }}
            {{ category(breakfastSides) }}
        </section>

        <section class="panel">
            {{ category(wraps) }}
            {{ category(sandwiches) }}
            {{ category(sides) }}
        </section>

        <section class="panel">
            {{ category(burgers) }}
            {{ category(soup) }}
        </section>
    </div>

</div>
