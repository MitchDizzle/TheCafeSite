{#- Category lookup by id rather than a hand-built dict — Nunjucks has no
    convenient way to assign into an object inside a template, but the
    `where` filter already exists for the studio board's own grouping. -#}
{%- set breakfast = (menu.categories | where("id", "breakfast"))[0] %}
{%- set breakfastSides = (menu.categories | where("id", "breakfast_sides"))[0] %}
{%- set wraps = (menu.categories | where("id", "wraps"))[0] %}
{%- set sandwiches = (menu.categories | where("id", "sandwiches"))[0] %}
{%- set hotSandwiches = (menu.categories | where("id", "hot_sandwiches"))[0] %}
{%- set burgers = (menu.categories | where("id", "burgers"))[0] %}
{%- set salads = (menu.categories | where("id", "salads"))[0] %}
{%- set soup = (menu.categories | where("id", "soup"))[0] %}
{%- set kids = (menu.categories | where("id", "kids"))[0] %}
{%- set sides = (menu.categories | where("id", "sides"))[0] %}
{%- set drinks = (menu.categories | where("id", "drinks"))[0] %}

{#- Dietary marks. Rendered in the order the codes are declared in
    menu.json's `diets` registry, not the order an item happens to list
    them, so GF/V/LS always read left to right the same way and the legend
    matches. `diet` is what the item IS; `dietOnRequest` is what the
    kitchen will make it into if asked, and takes the asterisk. -#}
{%- macro dietMarks(item) %}
{%- set served = item.diet or [] %}
{%- set onRequest = item.dietOnRequest or [] %}
{%- if served.length or onRequest.length -%}
<span class="menu-item-diet">
    {%- for d in menu.diets -%}
        {%- if d.code in served %}<abbr class="diet-mark" title="{{ d.name }}">{{ d.code }}</abbr>
        {%- elif d.code in onRequest %}<abbr class="diet-mark diet-mark--request" title="{{ d.name }} on request">{{ d.code }}*</abbr>
        {%- endif -%}
    {%- endfor -%}
</span>
{%- endif %}
{%- endmacro %}

{#- The key. Prints once per sheet, low on a panel, because a mark a
    customer cannot decode is worse than no mark. The shared-kitchen line is
    the one part of this piece that is there for liability rather than for
    reading — it prints. -#}
{%- macro dietLegend(compact=false) %}
<div class="diet-legend{% if compact %} diet-legend--compact{% endif %}">
    {%- if not compact %}
    <p class="p-label diet-legend-title ink-accent">Dietary key</p>
    {%- endif %}
    <p class="p-body diet-legend-keys">
        {%- for d in menu.diets %}<span class="diet-mark">{{ d.code }}</span>&nbsp;{{ d.name }}{% if not loop.last %} &middot; {% endif %}{% endfor -%}
        {%- if compact %} &middot; <span class="diet-mark">*</span>&nbsp;on request{% endif -%}
    </p>
    {%- if not compact %}
    <p class="p-body diet-legend-note"><span class="diet-mark">*</span> we can make it that way. Just ask.</p>
    {%- endif %}
    {#- Separate paragraph, not tacked onto the line above, because the two
        have different lifetimes: the asterisk note explains marks and goes
        when they do, the shared-kitchen caveat is a liability line that
        prints either way. -#}
    <p class="p-body diet-legend-caveat">{{ menu.dietNote }}</p>
    {#- The consumer advisory. Its own paragraph, and the LAST one, because it
        is the only line in this block that is not about us — the rest explain
        our marks and our kitchen, this one is a warning. It prints on every
        sheet and is never gated behind dietsConfirmed: see _note_health. -#}
    <p class="p-body diet-legend-advisory">{{ menu.healthNote }}</p>
</div>
{%- endmacro %}

{%- macro category(c) %}
<div class="menu-cat">
    <h3 class="menu-cat-name p-display ink-teal">{{ c.name }}</h3>
    {%- if c.serving %}
    <p class="menu-cat-sizing menu-cat-serving p-label ink-accent">{{ c.serving }}</p>
    {%- endif %}
    {%- if c.note %}
    <p class="menu-cat-note p-body">{{ c.note }}</p>
    {%- endif %}
    {%- if c.sizing %}
    <p class="menu-cat-sizing p-label ink-accent">
        {%- for s in c.sizing %}{{ s.size }} {{ s.price | money }}{% if not loop.last %} &middot; {% endif %}{% endfor -%}
    </p>
    {%- endif %}
    {%- if c.items %}
    <ul class="menu-items">
        {%- for item in c.items %}
        <li class="menu-item">
            <div class="menu-item-head">
                <span class="menu-item-name p-body">{{ item.name }}
                    {{- dietMarks(item) }}
                    {#- Screen and PNG only, never printed — see .price-review in
                        the stylesheet and the _note_price_review in menu.json.
                        Marks a price carried over from the old menu that has not
                        been re-costed. -#}
                    {%- if item.priceReview %}<span class="price-review" title="Price not re-costed yet">&bull;</span>{% endif -%}
                </span>
                {#- No leader and no price on the head row of an item priced by
                    variant — its prices are on the rows below, and dots running
                    out to blank space read as a price somebody forgot. -#}
                {%- if not item.variants %}
                <span class="menu-item-fill" aria-hidden="true"></span>
                {%- endif %}
                {%- if item.price %}
                <span class="menu-item-price p-body">{{ item.price | money }}</span>
                {%- elif item.prices %}
                {#- One item, one line, two prices — "2 / 3 Egg Omelet · $9.00 / $11.00".
                    The order matches the sizes in the item name, so the pairing is
                    implied and neither has to be labelled twice. Unlike `variants`,
                    which prints its own size words and therefore needs its own
                    rows — see below. -#}
                <span class="menu-item-price p-body">
                    {%- for pr in item.prices %}{{ pr | money }}{% if not loop.last %} / {% endif %}{% endfor -%}
                </span>
                {%- endif %}
            </div>
            {%- if item.description %}
            <p class="menu-item-desc p-body">{{ item.description }}</p>
            {%- endif %}
            {#- Variants get one indented row each, not a run-on string in the
                price column. "Biscuit or muffin $6.50 / Croissant, 2 eggs $8.00"
                is 48 characters of nowrap text in a column about an inch wide:
                it shoved the item name into two lines and ran off the fold.
                A variant is a priced row, so it is drawn as one. -#}
            {%- if item.variants %}
            <ul class="menu-variants">
                {%- for v in item.variants %}
                <li class="menu-variant">
                    <span class="menu-variant-name p-body">{{ v.size }}</span>
                    <span class="menu-item-fill" aria-hidden="true"></span>
                    <span class="menu-item-price p-body">{{ v.price | money }}</span>
                </li>
                {%- endfor %}
            </ul>
            {%- endif %}
        </li>
        {%- endfor %}
    </ul>
    {%- endif %}

    {#- A build-your-own category (see _note_picks in menu.json): columns of
        options under one category price, rather than one priced row per
        combination. Two columns of three is the kids meal; the grid does not
        care how many there are. -#}
    {%- if c.picks %}
    <div class="menu-picks">
        {%- for p in c.picks %}
        <div class="menu-pick">
            <p class="menu-pick-label p-label ink-accent">{{ p.label }}</p>
            <ul class="menu-pick-list">
                {%- for o in p.options %}
                <li class="menu-pick-option p-body">{{ o }}</li>
                {%- endfor %}
            </ul>
        </div>
        {%- endfor %}
    </div>
    {%- endif %}
</div>
{%- endmacro %}

{# Screen-only. There is no bleed room to print panel labels on the sheet
   itself, and mislabelling a panel costs a whole print run — so the roles are
   called out here, where they are visible while proofing in the browser and
   gone from the export and the print. #}
{#- `diets-unconfirmed` is what keeps the PDF honest. /menu links this
    piece as a printable menu, and the PDF is the PRINT rendering — so
    while menu.json's `dietsConfirmed` is false the marks come off the
    printed sheet the same way they are off the website, and only the PNG
    proof still shows them for the client to check. Exactly the contract
    .price-review already has: loud on the proof, absent from the paper. -#}
<div class="trifold-stack{% if not menu.dietsConfirmed %} diets-unconfirmed{% endif %}">

    {%- if not menu.dietsConfirmed %}
    <p class="fold-legend fold-legend--review fold-legend--warn">Dietary marks are drafted from the ingredient lists and are <strong>not kitchen-confirmed</strong> &mdash; do not send this to a printer until they are. Set <code>dietsConfirmed</code> in menu.json to clear this. Screen and PNG proof only.</p>
    {%- endif %}

    <p class="fold-legend fold-legend--review">A red <span class="price-review">&bull;</span> marks a price still to be re-costed. Screen and PNG proof only &mdash; it never prints.</p>

    <p class="fold-legend">Sheet 1 &mdash; outside &middot; <strong>tuck flap &mdash; BREAKFAST</strong> (first thing seen on opening) &middot; <strong>back cover</strong> &middot; <strong>front cover / flyer</strong></p>

    {#- OUTSIDE SHEET, as it lies flat, printed side up.

        Panel order here is dictated by the fold, not by reading order. Letter
        fold, right third in first, left third over it: the right panel ends
        up on top of the closed piece (front cover), the middle panel ends up
        on the bottom (back cover), and the LEFT panel is the one that tucks
        away inside — it is the panel a customer is reading the instant they
        lift the cover, before the piece is open flat.

        So the LEFT panel carries breakfast. Everything else on the menu can
        wait until the tri-fold is open; breakfast cannot. -#}
    <div class="canvas trifold-canvas">
        <div class="fold-line" style="left: 33.333%"></div>
        <div class="fold-line" style="left: 66.667%"></div>

        {#- THE TUCK FLAP, and the most valuable panel on the piece.

            It is the half-panel a customer is looking at the instant the
            cover lifts, before the tri-fold is open flat — so breakfast is
            here, not on the inside sheet. Breakfast is what this kitchen
            opens at six in the morning to sell. -#}
        <section class="panel panel-flap">
            {{ category(breakfast) }}
            {{ category(breakfastSides) }}

            <div class="panel-spacer"></div>
            {{ dietLegend() }}
        </section>

        <section class="panel panel-back">
            <p class="p-label panel-eyebrow ink-accent">Visit us</p>
            <p class="p-display panel-hours-days ink-teal">{{ site.opening.hoursDays }}</p>
            <p class="p-display panel-hours-time ink-teal">{{ site.opening.opens.time }} <span class="ampm">{{ site.opening.opens.meridiem }}</span> &ndash; {{ site.opening.closes.time }} <span class="ampm">{{ site.opening.closes.meridiem }}</span></p>

            <div class="panel-contact">
                <p class="p-display panel-phone ink-teal">{{ site.phone }}</p>
                <p class="p-body">{{ site.address.street }}</p>
                <p class="p-body">{{ site.address.locality }}, {{ site.address.region }} {{ site.address.postalCode }}</p>
                <p class="p-body">{{ site.email }}</p>
            </div>

            <div class="panel-note">
                <p class="p-label panel-note-label ink-accent">Catering &amp; meal prep</p>
                <p class="p-body panel-note-body">Trays, box lunches and full-service catering for offices, churches, funerals and family gatherings. Call ahead or ask at the counter and we will build a menu around your date.</p>
            </div>

            <div class="panel-spacer"></div>

            {# Both codes, side by side, on the panel that ends up face-up on
               a table. assets/qr-*.svg carry no quiet zone of their own —
               .qr's padding IS the quiet zone, so do not trim it. #}
            <div class="panel-codes">
                <div class="code">
                    <div class="qr code-qr">{% inlineSvg "/assets/qr-facebook.svg" %}</div>
                    <p class="p-label code-label ink-accent">Follow</p>
                    <p class="p-body code-line ink-teal">{{ site.social.facebookHandle }}</p>
                </div>
                <div class="code">
                    <div class="qr code-qr">{% inlineSvg "/assets/qr-website.svg" %}</div>
                    <p class="p-label code-label ink-accent">Order &amp; catering</p>
                    <p class="p-body code-line ink-teal">{{ site.social.website }}</p>
                </div>
            </div>
        </section>

        {#- FRONT COVER. Doubles as a flyer, so it has to stand on its own:
            hours, street address, phone and both links live here as well as
            on the back panel.

            NOT a flood of teal. A full-panel fill is a third of the sheet in
            solid ink on both a desktop printer and a copier — it cockles the
            paper and bleeds at the fold. Same answer as the front door
            banner's inset variant: one contained masthead box, everything
            else ruled or set in type on the bare sheet. -#}
        <section class="panel panel-cover">
            <div class="cover-mast">
                <div class="wordmark wordmark--light cover-wordmark">
                    {% inlineSvg "/assets/thecafe.svg", "", site.name %}
                </div>
                <p class="p-display-italic cover-menu ink-cream">Menu</p>
            </div>

            <div class="cover-filigree ink-teal">
                {% include "partials/filigree.njk" %}
            </div>

            <p class="p-display-italic cover-tagline ink-teal">Breakfast &amp; Lunch<br>Catering &amp; Meal Prep</p>
            <p class="p-body cover-since ink-teal">Serving Leavenworth since {{ site.founded.slice(0, 4) }}</p>

            <div class="panel-spacer"></div>

            <div class="cover-hours">
                <p class="p-label hours-label ink-accent">{{ site.opening.hoursLabel }}</p>
                <p class="p-display hours-days ink-teal">{{ site.opening.hoursDays }}</p>
                <p class="p-display hours-time ink-teal">{{ site.opening.opens.time }} <span class="ampm">{{ site.opening.opens.meridiem }}</span> &ndash; {{ site.opening.closes.time }} <span class="ampm">{{ site.opening.closes.meridiem }}</span></p>
            </div>

            <div class="cover-where">
                <p class="p-display cover-street ink-teal">{{ site.address.street }}</p>
                <p class="p-body cover-city">{{ site.address.locality }}, {{ site.address.region }} {{ site.address.postalCode }}</p>
                <p class="p-display cover-phone ink-teal">{{ site.phone }}</p>
            </div>

            <div class="cover-links">
                <p class="p-body cover-link ink-teal">{{ site.social.website }}</p>
                <p class="p-body cover-link ink-teal">{{ site.social.facebookHandle }}</p>
            </div>
        </section>
    </div>

    <p class="fold-legend">Sheet 2 &mdash; inside (opened flat) &middot; salads, soup &amp; kids &middot; wraps, cold sandwiches &amp; drinks &middot; griddle &amp; sides</p>

    {#- INSIDE SHEET — the rest of the menu, read left to right once the
        piece is open flat. Breakfast is NOT here; it is on the outside
        sheet's tuck flap, which is what a customer sees first. This sheet is
        lunch, running cold to hot: salads, soup and the kids meals, then the
        wraps and the deli case, then everything off the griddle.
        Do not reorder these without re-reading the fold note above.

        PANEL BALANCE is by hand and was re-struck when the kids meals, the
        two plates and the hot/cold sandwich split arrived. The three panels
        were re-struck again after the first proof overran. Drinks sit with the
        deli case and the sides sit with the griddle purely for fit — neither
        is a category that has to be anywhere in particular. If you add items, move a whole
        CATEGORY between panels rather than letting one panel overrun — a
        category split across a fold is the one failure this layout cannot
        absorb. Panels do not scroll; check the proof.

        The dietary key moved to the LEFT panel of this sheet. It used to sit
        under the griddle on the right, but that panel now carries the hot
        sandwiches as well as the burgers and has no room below them. -#}
    <div class="canvas trifold-canvas">
        <div class="fold-line" style="left: 33.333%"></div>
        <div class="fold-line" style="left: 66.667%"></div>

        <section class="panel">
            {{ category(salads) }}
            {{ category(soup) }}
            {{ category(kids) }}

            <div class="panel-spacer"></div>
            {{ dietLegend(true) }}
        </section>

        <section class="panel">
            {{ category(wraps) }}
            {{ category(sandwiches) }}
            {{ category(drinks) }}
        </section>

        {#- Burgers and hot sandwiches share this panel on purpose: same
            flat-top, and a customer deciding between a Patty Melt and a
            Reuben is making one decision, not two. See _note_hot_cold.
            The sides follow them for the same reason a side is ordered:
            with something off the griddle. -#}
        <section class="panel">
            {{ category(burgers) }}
            {{ category(hotSandwiches) }}
            {{ category(sides) }}
        </section>
    </div>

</div>
