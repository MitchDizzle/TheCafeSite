{#- ===========================================================
    Catering tri-fold — 11 × 8.5 landscape, two sides, letter-fold

    The buffet and event catering Dalton runs for the cafe, from
    _data/catering.json. Folded the same way as the menu tri-fold
    (menu-trifold-bw), and the panels are equal thirds like it.

      Sheet 1, outside:  tuck flap | back | front cover
      Sheet 2, inside:   left | middle | right

    Numbers run in reading order: the flap is what opens first, then the
    back, then the inside left to right. That is why the sections in
    catering.json are in this order; keep them so.

    Panels are fixed and CLIP, they never reflow: after adding a package,
    re-proof the PNG and move a whole section if a panel overruns.
    =========================================================== #}

{%- set g = catering | cateringGuide %}

{%- macro pkg(p) %}
<div class="cg-pkg">
    <p class="cg-pkg-head">
        <span class="cg-num">{{ p.n }}</span>
        <span class="cg-name">{{ p.name }}</span>
        <span class="cg-price">{% if p.priceLabel %}{{ p.priceLabel }}{% else %}{{ p.price | money }}{% endif %}</span>
    </p>
    {%- if p.with or p.sides %}
    <p class="cg-with">
        {%- if p.with %}{{ p.with | join(" · ") }}{% endif %}
        {%- if p.with and p.sides %} · {% endif %}
        {%- if p.sides %}<strong>{{ p.sides }} sides</strong> &amp; dessert{% endif -%}
    </p>
    {%- endif %}
</div>
{%- endmacro %}

{%- macro section(s) %}
<section class="cg-section">
    <h2 class="p-display cg-section-name">{{ s.name }}</h2>
    {%- if s.note %}<p class="cg-section-note">{{ s.note }}</p>{% endif %}
    {%- for p in s.packages %}{{ pkg(p) }}{% endfor %}
</section>
{%- endmacro %}

{%- macro sides(list) %}
<section class="cg-section cg-sides">
    <h2 class="p-display cg-section-name cg-section-name--small">{{ list.name }}</h2>
    <ul class="cg-sides-list">
        {%- for item in list.items %}<li>{{ item }}</li>{% endfor %}
    </ul>
</section>
{%- endmacro %}

<div class="cg-stack">

    <p class="fold-legend">Sheet 1 &mdash; outside &middot; <strong>tuck flap</strong> (first thing seen on opening) &middot; <strong>back</strong> &middot; <strong>front cover</strong></p>
    <div class="canvas cg-sheet">
        <div class="fold-line" style="left: 33.333%"></div>
        <div class="fold-line" style="left: 66.667%"></div>

        <div class="cg-panel">
            {{ section(g.byId.breakfast) }}
            {{ section(g.byId.lunches) }}
        </div>

        <div class="cg-panel">
            <section class="cg-how">
                <h2 class="p-display cg-section-name">How it works</h2>
                <ul>
                    {%- for line in catering.howItWorks %}<li>{{ line }}</li>{% endfor %}
                </ul>
            </section>
            {{ section(g.byId.cocktail) }}
        </div>

        <div class="cg-panel cg-cover">
            <div class="wordmark wordmark--light cg-wordmark">
                {% inlineSvg "/assets/thecafe.svg", "", site.name %}
            </div>
            <p class="p-display cg-cover-title">Catering</p>
            <p class="p-display-italic cg-cover-sub">The Café Catering<br><span class="cg-amp">&amp;</span> {{ catering.brand }}</p>
            <p class="cg-cover-line">Breakfasts, lunches, buffets and parties, from the kitchen that has cooked for Leavenworth since 2005.</p>
            <ul class="cg-cover-inside">
                {%- for s in g.sections %}<li><span>{{ s.name }}</span><span>from {{ s.from | money }}</span></li>{% endfor %}
            </ul>
            <p class="cg-cover-per">per person</p>
            <div class="cg-spacer"></div>
            <div class="cg-contact">
                <div class="cg-contact-text">
                    <p class="cg-contact-phone">{{ site.phone }}</p>
                    <p class="cg-contact-line">{{ catering.email }}</p>
                    <p class="cg-contact-line">{{ site.social.website }}/catering</p>
                    <p class="cg-contact-line">{{ site.address.street }}, {{ site.address.locality }}</p>
                </div>
                <div class="qr cg-qr" aria-hidden="true">{% inlineSvg "/assets/qr-website.svg", "", "" %}</div>
            </div>
        </div>
    </div>

    <p class="fold-legend">Sheet 2 &mdash; inside (opened flat) &middot; drop-off buffets &middot; buffets &amp; sides &middot; BBQ &amp; Southwest &amp; sides</p>
    <div class="canvas cg-sheet">
        <div class="fold-line" style="left: 33.333%"></div>
        <div class="fold-line" style="left: 66.667%"></div>

        <div class="cg-panel">
            {{ section(g.byId.dropoff) }}
            <div class="cg-spacer"></div>
            <p class="cg-call">To order, call <strong>{{ site.phone }}</strong> with the package number and how many guests.</p>
        </div>

        <div class="cg-panel">
            {{ section(g.byId.buffets) }}
            {{ sides(catering.sides.buffet) }}
        </div>

        <div class="cg-panel">
            {{ section(g.byId.bbq) }}
            {{ sides(catering.sides.bbq) }}
        </div>
    </div>

</div>
