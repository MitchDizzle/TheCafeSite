---
layout: layouts/base.njk
title: "Downloads — The Café Studio"
description: "Internal download list."
pageCss: "/assets/css/downloads.css"
bodyClass: "downloads-body"
noSiteJs: true
eleventyExcludeFromCollections: true

# NOT the flat `studio/downloads.html` that src/src.11tydata.js would give
# this file. scripts/export-studio.js writes the exported PNGs and PDFs into
# _site/studio/downloads/, and Apache's mod_dir redirects a request for
# /studio/downloads to /studio/downloads/ the moment that directory exists —
# which would land on a missing index and 404. So the page IS that directory's
# index, and it sits beside the files it lists.
permalink: "/studio/downloads/index.html"
---
{#- The list is built from the same collection as the board, so a new piece in
    src/studio/ is downloadable the moment it is on the board — there is no
    second list to update.

    The links are written unconditionally rather than probed: Eleventy runs
    BEFORE the exporter, so at build time none of these files exist yet. That
    is why `npm run build` runs the exporter too and why the exporter fails the
    build if a piece will not render — a link here must never dangle. -#}
{%- set groups = [] %}
{%- for piece in collections.studio %}
  {%- if piece.data.studioCategory not in groups %}
    {%- set _ = groups.push(piece.data.studioCategory or "Pages") %}
  {%- endif %}
{%- endfor %}

<header class="dl-head">
    <p class="dl-kicker">Internal &middot; not linked, not indexed</p>
    <h1 class="dl-title">Downloads</h1>
    <p class="dl-lede">
        Every studio piece, exported at full size. Made for a phone &mdash; tap a
        PNG to save it to your camera roll and post it straight from there.
    </p>
    <p class="dl-note">
        <strong>PNG</strong> for posting. <strong>PDF</strong> for printing &mdash;
        it stays vector at the real sheet size, and it leaves out the proofing
        marks the PNG shows.
    </p>
    <p class="dl-back"><a href="/studio/">&larr; Back to the board</a></p>
</header>

<main class="dl-main">
    {%- for name in groups %}
    <section class="dl-section">
        <h2 class="dl-section-title">{{ name }}</h2>

        <ul class="dl-list">
            {%- for piece in collections.studio %}
            {%- if (piece.data.studioCategory or "Pages") == name %}
            <li class="dl-item">
                {#- The thumbnail is the exported PNG itself, not a live iframe
                    like the board uses. This page is for a phone on a café
                    wifi: seven artboards in seven iframes is seven full page
                    loads with webfonts, and lazy-loaded images are a fraction
                    of that. -#}
                <a class="dl-thumb" href="/studio/downloads/{{ piece.fileSlug }}.png" target="_blank" rel="noopener">
                    <img src="/studio/downloads/{{ piece.fileSlug }}.png"
                         alt="{{ piece.data.studioTitle or piece.data.title }}"
                         loading="lazy">
                </a>

                <div class="dl-body">
                    <h3 class="dl-name">{{ piece.data.studioTitle or piece.data.title }}</h3>
                    {%- if piece.data.studioSize %}
                    <p class="dl-meta">{{ piece.data.studioSize }}</p>
                    {%- endif %}

                    {#- `download` rather than a plain link: on a phone a bare
                        link to a PNG opens the image in a tab and the file has
                        to be long-pressed out of it. With the attribute it
                        goes straight to the downloads folder. -#}
                    <div class="dl-actions">
                        <a class="dl-btn" href="/studio/downloads/{{ piece.fileSlug }}.png" download>PNG</a>
                        {%- if piece.data.pageSize %}
                        <a class="dl-btn dl-btn--ghost" href="/studio/downloads/{{ piece.fileSlug }}.pdf" download>PDF</a>
                        {%- endif %}
                        <a class="dl-btn dl-btn--quiet" href="{{ piece.url }}">Open</a>
                    </div>

                    {%- if piece.data.facts %}
                    {#- Raw material for writing the post, on the same screen
                        as the image it goes with. The point is not to save a
                        file somewhere — it is that the post gets written on a
                        phone, and every app switch to go look up an hour or a
                        price is a chance to get one wrong. -#}
                    <details class="dl-facts">
                        <summary>Facts for the post</summary>
                        {%- for block in piece.data.facts %}
                        <h4 class="dl-facts-group">{{ block.group }}</h4>
                        <ul class="dl-facts-list">
                            {%- for fact in block.items %}
                            {#- Nunjucks has no startswith; `in` on a string is a
                                substring test, which is all this needs. -#}
                            <li{% if "ASK:" in fact or "NEEDED:" in fact %} class="dl-fact--gap"{% elif "Do NOT" in fact or "Nothing about" in fact or "not 'grand opening'" in fact | lower %} class="dl-fact--warn"{% endif %}>{{ fact }}</li>
                            {%- endfor %}
                        </ul>
                        {%- endfor %}
                    </details>
                    {%- endif %}

                    {%- if piece.data.caption %}
                    {#- The caption ships with the piece. A post is the image
                        AND the words, and splitting them across a repo file
                        and a phone is how a post goes out with the wrong date
                        in the text. Collapsed by default so the list stays
                        scannable. -#}
                    <details class="dl-caption">
                        <summary>Draft caption</summary>
                        <div class="dl-caption-body" id="cap-{{ piece.fileSlug }}">
                            {%- for para in piece.data.caption %}
                            <p>{{ para }}</p>
                            {%- endfor %}
                        </div>
                        <button class="dl-btn dl-btn--ghost dl-copy" type="button" data-copy="cap-{{ piece.fileSlug }}">Copy caption</button>
                    </details>
                    {%- endif %}
                </div>
            </li>
            {%- endif %}
            {%- endfor %}
        </ul>
    </section>
    {%- endfor %}
</main>

<script>
(function () {
    // Copy a caption to the clipboard, paragraphs separated by a blank line
    // the way Facebook's composer expects them.
    //
    // navigator.clipboard needs a secure context; over plain http on a phone
    // it is simply undefined. The fallback selects the text instead, which
    // leaves the OS "Copy" affordance one tap away rather than failing
    // silently — a copy button that does nothing is worse than no button.
    document.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-copy]');
        if (!btn) return;

        var body = document.getElementById(btn.dataset.copy);
        if (!body) return;

        var text = Array.prototype.map
            .call(body.querySelectorAll('p'), function (p) { return p.textContent.trim(); })
            .join('

');

        var done = function (label) {
            var original = btn.dataset.label || btn.textContent;
            btn.dataset.label = original;
            btn.textContent = label;
            setTimeout(function () { btn.textContent = original; }, 2000);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
                function () { done('Copied'); },
                function () { select(body); done('Select & copy'); }
            );
        } else {
            select(body);
            done('Select & copy');
        }
    });

    function select(body) {
        var range = document.createRange();
        range.selectNodeContents(body);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
    }
}());
</script>
