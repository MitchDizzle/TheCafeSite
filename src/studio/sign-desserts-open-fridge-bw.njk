canvasW: "8.5in"
canvasH: "11in"
pageSize: "8.5in 11in"
pageCss: "/assets/css/studio/sign.css"
bw: true
fridgeKinds: ["Cream Puffs", "Banana Pudding", "Strawberry Trifle"]
tags: studio
studioData: ["desserts.json"]
studioTitle: "Open fridge desserts sign (not self serve) — black & white"
studioCategory: "Signs"
studioSize: "8.5 × 11 in portrait · letter, on the fridge out in the open"
studioNote: "For the fridge out in the open: the cream puffs, banana pudding and strawberry trifle with their prices from Square, and a caution panel: not self serve, please do not open."
