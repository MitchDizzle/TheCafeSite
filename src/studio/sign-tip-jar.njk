{#- A label, not a wrap. A gallon pickle jar is about 20in round, more than
    a letter sheet, and a wrap's ends meet behind the jar where nobody reads
    them. A 10in strip covers the half that faces the counter. Everything is
    centred and kept off the ends, which curve away from view. -#}
<div class="canvas sign sign--bw tipjar-sheet">
    {%- for n in [1, 2] %}
    <div class="tipjar">
        <div class="wordmark wordmark--ink tipjar-mark">
            {% inlineSvg "/assets/thecafe.svg", "", site.name %}
        </div>
        <p class="p-display tipjar-word">Tips</p>
        <p class="p-display-italic tipjar-thanks">Thank you!</p>
    </div>
    {%- endfor %}
</div>
