# same fields, so the picture and the words can't disagree.
promoDate: "2026-10-30"
cookie: "Brown Butter M&M Chocolate Chip"
cookieSub: "Gluten-free"
# Mitch's cut-out of a real cookie, a PNG with a transparent background.
