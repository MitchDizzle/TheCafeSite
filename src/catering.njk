---
layout: layouts/page.njk
title: "Catering | The Café"
description: "Book catering from The Café in Leavenworth, KS — office lunches, meetings, and events. Send a booking request online or call to order."
ogDescription: "Catering for offices, meetings, and events in Leavenworth, KS. Book online or call to order."
pageCss: "/assets/css/catering.css"
---
<!-- Packages/menu section removed for now — becomes its own page once
             real menu items exist (old bundle markup is in git history). -->

        <!-- ── Booking Form ─────────────────────────────────── -->
        <section class="section" id="inquiry" aria-labelledby="inquiry-heading">
            <div class="container">
                <h1 id="inquiry-heading">Book a Catering</h1>
                <p style="margin-top: 0.75rem; max-width: 55ch;">
                    Tell us about your event and we'll follow up with availability and a custom quote.
                </p>

                <div class="call-strip">
                    Fastest way to book: call us at <a href="tel:+19135479994">(913) 547-9994</a>.
                    <!-- TODO: confirm phone number + lead time with client -->
                </div>

                <form action="https://formspree.io/f/xzdlnpnw" method="POST" novalidate
                      data-success="Thank you! Your booking request is on its way — we'll follow up with availability and a custom quote.">

                    <!-- honeypot: humans never see or fill this -->
                    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"
                           style="position:absolute; left:-9999px;" aria-hidden="true">
                    <input type="hidden" name="_subject" value="Catering booking request — website form">

                    <div class="form-grid">

                        <!-- ── Contact ── -->
                        <div class="form-group">
                            <label for="name">Name <span style="color:var(--accent-dark)">*</span></label>
                            <input type="text" id="name" name="name" autocomplete="name" required placeholder="Jane Smith">
                        </div>

                        <div class="form-group">
                            <label for="org">Company / Organization</label>
                            <input type="text" id="org" name="organization" autocomplete="organization" placeholder="Optional">
                        </div>

                        <div class="form-group">
                            <label for="email">Email <span style="color:var(--accent-dark)">*</span></label>
                            <input type="email" id="email" name="email" autocomplete="email" required placeholder="jane@example.com">
                        </div>

                        <div class="form-group">
                            <label for="phone">Phone <span style="color:var(--accent-dark)">*</span></label>
                            <input type="tel" id="phone" name="phone" autocomplete="tel" required placeholder="(555) 000-0000">
                        </div>

                        <!-- ── Event Details ── -->
                        <h3 class="form-section-heading">Event Details</h3>

                        <div class="form-group">
                            <label for="event-name">Name of Event</label>
                            <input type="text" id="event-name" name="event_name" placeholder="Birthday party, corporate lunch…">
                        </div>

                        <div class="form-group">
                            <label for="event-location">Event Location</label>
                            <input type="text" id="event-location" name="event_location" placeholder="Venue or address">
                        </div>

                        <div class="form-group">
                            <label for="date">Event Date <span style="color:var(--accent-dark)">*</span></label>
                            <input type="date" id="date" name="event_date" required>
                        </div>

                        <div class="form-group">
                            <label for="guests">Guest Count <span style="color:var(--accent-dark)">*</span></label>
                            <input type="number" id="guests" name="guest_count" min="15" required placeholder="Minimum 15">
                            <span class="form-hint">Minimum 15 guests</span>
                        </div>

                        <div class="form-group">
                            <label for="start-time">Start Time</label>
                            <input type="time" id="start-time" name="start_time">
                        </div>

                        <div class="form-group">
                            <label for="end-time">End Time</label>
                            <input type="time" id="end-time" name="end_time">
                        </div>

                        <!-- ── Service Preferences ── -->
                        <h3 class="form-section-heading">Service Preferences</h3>

                        <div class="form-group">
                            <label for="service-style">Style of Service</label>
                            <select id="service-style" name="service_style">
                                <option value="">— Select one —</option>
                                <option value="Buffet">Buffet</option>
                                <option value="Sit Down">Sit Down Dinner</option>
                                <option value="Drop Off">Drop Off</option>
                                <option value="Appetizer">Appetizer / Reception</option>
                                <option value="Stations">Stations</option>
                                <option value="Unsure">Not sure yet</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="budget">Budget (optional)</label>
                            <input type="text" id="budget" name="budget" placeholder="e.g. $500, open to quote">
                        </div>

                        <div class="form-group form-group--full">
                            <label>Additional Items Needed</label>
                            <div class="checkbox-group">
                                <label><input type="checkbox" name="extras" value="Table Linen"> Table Linen</label>
                                <label><input type="checkbox" name="extras" value="China"> China</label>
                                <label><input type="checkbox" name="extras" value="Servers"> Servers for the meal</label>
                                <label><input type="checkbox" name="extras" value="Plasticware"> Plasticware</label>
                                <label><input type="checkbox" name="extras" value="None"> None / Food only</label>
                            </div>
                        </div>

                        <div class="form-group form-group--full">
                            <label for="message">Additional Requests or Requirements</label>
                            <textarea id="message" name="message" placeholder="Food allergies, dietary restrictions, anything else we should know…"></textarea>
                        </div>

                        <div class="form-group form-group--full form-submit">
                            <button type="submit" class="btn btn-primary">Send Inquiry</button>
                            <p class="form-privacy" style="margin-top:0.6rem;">
                                We only use your details to respond to this inquiry.
                                See our <a href="privacy">privacy policy</a>.
                            </p>
                        </div>

                    </div>
                </form>
            </div>
        </section>
